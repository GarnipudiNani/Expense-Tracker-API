# Copy this file to .env for local development or Docker Compose.
# Replace the obvious development-only values before deploying.

# Host connection for running the app directly with local PostgreSQL.
# Docker Compose builds the API's in-container URL from POSTGRES_* below.
DATABASE_URL=postgresql://expense_tracker:dev-only-password@localhost:5432/expense_tracker
POSTGRES_USER=expense_tracker
POSTGRES_PASSWORD=dev-only-password
POSTGRES_DB=expense_tracker

# Development-only placeholder. Generate a strong secret before deployment:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-only-change-this-secret

# Optional: JWT access token lifetime in minutes (defaults to 30)
ACCESS_TOKEN_EXPIRE_MINUTES=30
